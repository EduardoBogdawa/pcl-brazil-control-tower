VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Microsoft Entra ID sign-in (from your app registration)
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
# Optional: defaults to https://login.microsoftonline.com/<tenant id>
VITE_ENTRA_AUTHORITY=
# Optional: extra API scope requested at sign-in, e.g. api://<api client id>/access_as_user
VITE_ENTRA_API_SCOPE=
# true = skip Entra sign-in (local development only, never in production)
VITE_DEV_MODE=false
