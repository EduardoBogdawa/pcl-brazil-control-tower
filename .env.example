VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Microsoft Entra ID. Register, under the "Single-page application" platform, <site origin>/auth-redirect.html
# for every origin used (e.g. http://localhost:5173/auth-redirect.html, http://localhost:8080/auth-redirect.html).
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
# Optional: defaults to https://login.microsoftonline.com/<tenant id>
VITE_ENTRA_AUTHORITY=
# Optional: API scope to request at sign-in, e.g. api://<api client id>/access_as_user
VITE_ENTRA_API_SCOPE=

# true skips Microsoft sign-in, honored only by the local dev server (never in production builds)
VITE_DEV_MODE=false
